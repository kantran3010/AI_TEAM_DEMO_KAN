# ==============================================================
# CẤU HÌNH API KEYS CHO AI MULTI-AGENT DEV TEAM
# ==============================================================

# 1. Google Gemini API (Khuyến nghị: Miễn phí, tốc độ cao, hỗ trợ context lớn)
# Lấy API Key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Hoặc OpenAI API (GPT-4o, GPT-4o-mini)
# OPENAI_API_KEY=

# 3. Hoặc Groq API (Tốc độ cực nhanh cho Llama 3)
# GROQ_API_KEY=

# 4. Hoặc Anthropic Claude API
# ANTHROPIC_API_KEY=

# Model mặc định:
# Ví dụ: gemini/gemini-2.5-flash, gemini/gemini-1.5-pro, gpt-4o-mini, groq/llama-3.3-70b-versatile
AI_MODEL=gemini/gemini-2.5-flash

# Số vòng lặp tự sửa lỗi tối đa khi Tester bắt gặp bug (Self-Healing)
MAX_RETRY_ROUNDS=3

# Thư mục lưu kết quả đầu ra
WORKSPACE_DIR=workspace
